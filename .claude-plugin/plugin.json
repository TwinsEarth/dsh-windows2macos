{
  "name": "w2m-fleet",
  "description": "Drive the same project on online Windows, macOS and Linux machines from one account: read fleet state, dispatch commands and read results. The MCP surface is deliberately read-only.",
  "version": "2.0.1",
  "author": {
    "name": "TwinsEarth"
  },
  "homepage": "https://github.com/TwinsEarth/dsh-windows2macos",
  "repository": "https://github.com/TwinsEarth/dsh-windows2macos",
  "license": "MIT",
  "keywords": [
    "fleet",
    "remote-execution",
    "windows",
    "macos",
    "linux",
    "mcp",
    "claude-code",
    "codex"
  ],
  "mcpServers": {
    "w2m-fleet": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/bin/w2m-mcp.mjs"
      ]
    }
  }
}
