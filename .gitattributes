# Repository-wide line-ending policy.
#
# This file exists for a specific, measured reason: two machines running the same
# project must produce byte-identical working trees, or the tree fingerprint will
# differ and every cross-machine comparison is reported as "divergent" instead of
# "consistent".
#
# Measured on Windows (core.autocrlf=true) vs a checkout with core.autocrlf=false:
# with this file present the working-tree bytes are identical (6c 31 0a 6c 32 0a);
# without it one side is CRLF and the other LF.
#
# Do not remove without reading PROTOCOL.md section 6 (anchors).
* text=auto eol=lf

# Keep binary assets binary.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.zip binary
*.tgz binary
*.exe binary
*.dll binary
*.node binary

# Lockfiles are generated; keep them LF and non-diffable.
pnpm-lock.yaml text eol=lf
package-lock.json text eol=lf

# Windows scripts must stay CRLF so cmd.exe is happy.
*.cmd text eol=crlf
*.bat text eol=crlf
